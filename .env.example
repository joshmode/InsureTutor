# ---------------------------------------------------------------------------
# InsureTutor model provider (any OpenAI-compatible /chat/completions API)
# ---------------------------------------------------------------------------
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=1200
LLM_TIMEOUT_SECONDS=60

# Optional extra request headers, formatted as "header:value;header:value".
# Most providers do not need this.
LLM_EXTRA_HEADERS=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
APP_PORT=8000

# Relative to the repository root. The supplied brochure is ingested at startup.
KNOWLEDGE_BASE_DIR=/app/knowledge
DOCUMENTS=FLEXI-ULife Prime Saver.pdf
DATA_DIR=/app/data

# Re-ingest source PDFs at every startup. Set to false to load the persisted index.
INGEST_ON_STARTUP=true

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
# Local ONNX model downloaded once and cached in DATA_DIR/model-cache. It does
# not use the configured LLM provider. If unavailable, BM25 remains active.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_ENABLED=true
# Deprecated: runtime never downloads model artifacts. Use the setup script
# with --revision FULL_UPSTREAM_COMMIT to cache a reviewed ONNX snapshot.
EMBEDDING_ALLOW_DOWNLOAD=false
EMBEDDING_CACHE_DIR=/app/data/model-cache
EMBEDDING_BATCH_SIZE=32

# Hybrid scoring weights. Set ENABLE_EMBEDDINGS=false to force lexical mode.
ENABLE_EMBEDDINGS=true
HYBRID_VECTOR_WEIGHT=0.55
HYBRID_LEXICAL_WEIGHT=0.45
RETRIEVAL_TOP_K=6
RETRIEVAL_CANDIDATE_LIMIT=16
MIN_RELEVANCE_SCORE=0.18
MAX_CONTEXT_CHUNKS=6

# ---------------------------------------------------------------------------
# Safety / conversation
# ---------------------------------------------------------------------------
MAX_MESSAGE_CHARS=4000
MAX_HISTORY_TURNS=8
MAX_RETRIEVAL_QUERIES=4


# Public-demo safeguards. Persist DATA_DIR to preserve allowances across restarts.
MAX_REQUEST_BYTES=262144
REQUEST_READ_TIMEOUT_SECONDS=10
CHAT_TIMEOUT_SECONDS=180
CHAT_REQUESTS_PER_MINUTE=20
CHAT_REQUESTS_PER_DAY=500
CHAT_CONCURRENCY_LIMIT=4
PROVIDER_CALLS_PER_DAY=300
PROVIDER_OUTPUT_TOKENS_PER_DAY=360000
MAX_PROVIDER_INPUT_BYTES=64000

# Optional browser-native access protection for a private demo. Set BOTH.
# Serve remote deployments through HTTPS; never put these values in frontend code.
APP_ACCESS_USERNAME=
APP_ACCESS_PASSWORD=

MAX_PROVIDER_RESPONSE_BYTES=262144
# Optional: default pinned model location is EMBEDDING_CACHE_DIR/pinned
# EMBEDDING_LOCAL_MODEL_DIR=/app/data/model-cache/pinned
